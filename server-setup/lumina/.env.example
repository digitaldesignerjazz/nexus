# Nexus → LuminaCyberspace package (alpha.2)
# Copy to .env and adjust. Never commit .env.

LUMINA_NODE_NAME=lumina-local
LUMINA_SITE=local
LUMINA_OWNER="Operator"

# Runtime root (defaults to this package's runtime/)
# LUMINA_ROOT=

# Snapshot pin — leave empty to use pins/SNAPSHOT_URL.txt
# SNAPSHOT_URL=
# SNAPSHOT_SHA256=

# Python interpreter (prefer a venv with pynacl for overlay)
# LUMINA_PYTHON=python3

# Optional mesh
# YGGDRASIL_CONF=
# ENABLE_YGGDRASIL=0

# Hannover-only extras (onyx-listen, actions-runner, dockerd) — OFF by default
ENABLE_HANNOVER_EXTRAS=0

# Control plane smoke (if already running)
NEXUS_CONTROL_URL=http://127.0.0.1:8787
